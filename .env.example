# Copy to .env (never commit .env).
# Needed only for dev/harness and evals on OpenRouter free models.
OPENROUTER_API_KEY=

# Optional: contact shown in the User-Agent sent to Wikimedia (their API policy asks for one).
# Defaults to the project's repository URL.
WIR_CONTACT=

# Optional: where the HTTP cache lives (default: ~/.cache/wikipedia-interest-research).
WIR_HOME=
